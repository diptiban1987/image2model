/* ui/desktop/styles.qss
   Professional dark theme for ImageTo3D Pro */

QWidget {
    background-color: #1e1e1e;
    color: #ffffff;
    font-family: "Segoe UI", system-ui;
    font-size: 13px;
}

QGroupBox {
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    margin-top: 8px;
    padding: 10px;
    font-weight: bold;
    color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #4A90E2;
}

QPushButton {
    background-color: #4A90E2;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: 600;
    min-width: 100px;
}

QPushButton:hover {
    background-color: #5BA0F2;
}

QPushButton:pressed {
    background-color: #3A7BC8;
}

QPushButton:disabled {
    background-color: #3a3a3a;
    color: #666666;
}

QProgressBar {
    background-color: #2b2b2b;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    height: 20px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4A90E2, stop:1 #5BA0F2);
    border-radius: 4px;
}

QLineEdit {
    background-color: #252525;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px;
    color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #4A90E2;
}

QComboBox {
    background-color: #252525;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px;
    color: #ffffff;
}

QPlainTextEdit {
    background-color: #252525;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px;
    color: #cccccc;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid #3a3a3a;
}

QRadioButton::indicator:checked {
    background-color: #4A90E2;
    border: 1px solid #4A90E2;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #3a3a3a;
}

QCheckBox::indicator:checked {
    background-color: #4A90E2;
    border: 1px solid #4A90E2;
}

/* Multi-Angle Widget Specific Styling */
MultiAngleWidget QGroupBox {
    border: 2px solid #3498db;
    background-color: #2a2a2a;
}

MultiAngleWidget QLabel#drop_label {
    border: 2px dashed #4A90E2;
    background-color: #2b2b2b;
    color: #4A90E2;
}

MultiAngleWidget QListWidget::item:hover {
    background-color: #3a3a3a;
}