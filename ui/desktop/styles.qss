/* ═══════════════════════════════════════════════════════════════ */
/*  ImageTo3D Pro — Premium Dark Theme                            */
/*  Matches the web app's glassmorphism-inspired design            */
/* ═══════════════════════════════════════════════════════════════ */

/* ── Animations ── */
@keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

@keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.7; }
    100% { opacity: 1; }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-10px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes glow {
    0% { box-shadow: 0 0 5px rgba(59, 130, 246, 0.5); }
    50% { box-shadow: 0 0 20px rgba(139, 92, 246, 0.8); }
    100% { box-shadow: 0 0 5px rgba(59, 130, 246, 0.5); }
}

/* ── Global ── */
QWidget {
    background-color: #111111;
    color: #e5e7eb;
    font-family: "Segoe UI", "Inter", system-ui, sans-serif;
    font-size: 13px;
}

/* ── Group Boxes ── */
QGroupBox {
    border: 1px solid #1e293b;
    border-radius: 8px;
    margin-top: 12px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
    color: #e5e7eb;
    background-color: #161616;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #60a5fa;
    font-size: 13px;
}

/* ── Buttons ── */
QPushButton {
    background-color: #1e293b;
    color: #e5e7eb;
    border: 1px solid #334155;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 600;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #334155;
    border-color: #60a5fa;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #0f172a;
    border-color: #3b82f6;
}

QPushButton:disabled {
    background-color: #1a1a2e;
    color: #475569;
    border-color: #1e293b;
}

/* ── Progress Bar ── */
QProgressBar {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    height: 28px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    font-size: 13px;
    font-family: "Segoe UI", "Inter", sans-serif;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #06b6d4,
        stop:0.2 #3b82f6,
        stop:0.4 #8b5cf6,
        stop:0.6 #ec4899,
        stop:0.8 #f59e0b,
        stop:1 #10b981
    );
    background-size: 200% 100%;
    border-radius: 8px;
    animation: gradientShift 3s ease infinite;
}

QProgressBar[progressMode="indeterminate"]::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #06b6d4,
        stop:0.2 #3b82f6,
        stop:0.4 #8b5cf6,
        stop:0.6 #ec4899,
        stop:0.8 #f59e0b,
        stop:1 #10b981
    );
    background-size: 200% 100%;
    animation: gradientShift 1.5s ease infinite;
}

/* ── Text Input ── */
QLineEdit {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 8px 10px;
    color: #e5e7eb;
    font-size: 13px;
    selection-background-color: #3b82f6;
}

QLineEdit:focus {
    border: 1px solid #60a5fa;
    background-color: #1e293b;
}

QLineEdit:disabled {
    background-color: #0a0a0a;
    color: #475569;
}

QLineEdit[readOnly="true"] {
    background-color: #0a0f1a;
    color: #94a3b8;
}

/* ── Combo Box ── */
QComboBox {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 28px 6px 10px;
    color: #e5e7eb;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #60a5fa;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1e293b;
    border: 1px solid #334155;
    selection-background-color: #3b82f6;
    color: #e5e7eb;
    padding: 4px;
}

/* ── Log / Text Area ── */
QPlainTextEdit {
    background-color: #0a0a0a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 8px;
    color: #94a3b8;
    font-family: "Cascadia Code", "JetBrains Mono", "Consolas", "Courier New", monospace;
    font-size: 11px;
    selection-background-color: #3b82f6;
}

/* ── Radio Buttons ── */
QRadioButton {
    spacing: 6px;
    color: #e5e7eb;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #475569;
    background-color: #0f172a;
}

QRadioButton::indicator:checked {
    background-color: #3b82f6;
    border: 2px solid #60a5fa;
}

QRadioButton::indicator:hover {
    border-color: #60a5fa;
}

/* ── Check Boxes ── */
QCheckBox {
    spacing: 6px;
    color: #e5e7eb;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #475569;
    background-color: #0f172a;
}

QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border: 2px solid #60a5fa;
}

QCheckBox::indicator:hover {
    border-color: #60a5fa;
}

/* ── Labels ── */
QLabel {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* ── Scroll Bars ── */
QScrollBar:vertical {
    background-color: #111111;
    width: 8px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #334155;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #475569;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #111111;
    height: 8px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #334155;
    border-radius: 4px;
    min-width: 30px;
}

/* ── Tab Widget ── */
QTabWidget::pane {
    border: 1px solid #1e293b;
    border-radius: 6px;
    background-color: #161616;
}

QTabBar::tab {
    background-color: #0f172a;
    color: #94a3b8;
    padding: 8px 16px;
    border: 1px solid #1e293b;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #161616;
    color: #60a5fa;
    font-weight: bold;
}

QTabBar::tab:hover {
    background-color: #1e293b;
    color: #e5e7eb;
}

/* ── Dialogs ── */
QDialog {
    background-color: #111111;
}

QDialogButtonBox {
    background-color: transparent;
}

/* ── Message Box ── */
QMessageBox {
    background-color: #161616;
}

QMessageBox QLabel {
    color: #e5e7eb;
}

/* ── Frames / Separators ── */
QFrame[frameShape="4"], /* HLine */
QFrame[frameShape="5"]  /* VLine */ {
    background-color: #1e293b;
    max-height: 1px;
}

/* ── Group-specific overrides ── */
QGroupBox#deviceBox {
    border-color: #3b82f6;
}

QGroupBox#systemBox {
    border-color: #1e293b;
}

/* ── Multi-Angle Widget ── */
MultiAngleWidget QGroupBox {
    border: 2px solid #3b82f6;
    background-color: #161616;
}

MultiAngleWidget QLabel#drop_label {
    border: 2px dashed #60a5fa;
    background-color: #0f172a;
    color: #60a5fa;
    border-radius: 8px;
}

MultiAngleWidget QListWidget {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 4px;
}

MultiAngleWidget QListWidget::item:hover {
    background-color: #1e293b;
}

/* ── Tooltips ── */
QToolTip {
    background-color: #1e293b;
    color: #e5e7eb;
    border: 1px solid #334155;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 12px;
}